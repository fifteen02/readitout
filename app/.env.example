# Copy this file to .env and fill it in (.env is git-ignored).
#   cp .env.example .env

# Firebase project id (required) — the "Project ID" from console.firebase.google.com
FIREBASE_PROJECT_ID=your-firebase-project-id

# Optional: a specific Hosting site id — only if your project has more than one site.
# Leave unset to use the project's default site.
# FIREBASE_HOSTING_SITE=

# Optional: CI token for non-interactive deploys (generate with: firebase login:ci).
# Leave empty to use your local `firebase login` session instead.
# FIREBASE_TOKEN=
